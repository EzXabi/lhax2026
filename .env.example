# Copy to .env.local. The password is a public throwaway demo value.
DEMO_PASSWORD=123
# Generate a fresh random value for every installation. Never commit this value.
SESSION_SECRET=

# Optional canonical origin, especially when HTTPS is terminated by a proxy.
# Example: http://localhost:3000 (no trailing slash)
APP_ORIGIN=

# Optional English card narration. No credentials are needed for the core demo.
ELEVENLABS_API_KEY=

# Optional voice and model overrides. All input text is English.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
